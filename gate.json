{
  "steps": [
    {
      "name": "workspace-packages",
      "command": "node scripts/verify-workspace-packages.mjs",
      "timeout_sec": 60,
      "expect_exit": 0,
      "min_count": { "regex": "workspace packages: OK", "count": 1 }
    },
    {
      "name": "typecheck",
      "command": "pnpm -r typecheck",
      "timeout_sec": 600,
      "expect_exit": 0,
      "must_not_match": "error TS[0-9]{4}",
      "min_count": { "regex": "typecheck: Done", "count": 4 }
    },
    {
      "name": "node-resolution",
      "command": "node core/scripts/verify-node-resolution.mjs",
      "timeout_sec": 120,
      "expect_exit": 0,
      "min_count": { "regex": "resolution: OK", "count": 2 }
    },
    {
      "name": "test",
      "command": "pnpm -r test",
      "timeout_sec": 600,
      "expect_exit": 0,
      "must_not_match": "No test files found|Tests  no tests",
      "min_count": { "regex": "Tests  [0-9]+ passed", "count": 4 }
    }
  ]
}
