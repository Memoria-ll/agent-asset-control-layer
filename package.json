{
  "name": "aacl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "aacl": "bin/aacl.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "prepack": "npm run build",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/stdio.ts",
    "cli": "node bin/aacl.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write server src tests package.json tsconfig.json vite.config.ts playwright.config.ts README.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.1"
  }
}
